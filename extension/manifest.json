{
  "manifest_version": 3,
  "name": "MuDiKo Hub-Upload (Prototyp)",
  "version": "0.1.0",
  "description": "Sendet Google-AI-Studio-Projekte als ZIP direkt in den Deployment-Bereich des MuDiKo Musik Hubs.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "MuDiKo Hub-Upload öffnen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "downloads"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://music.ifib.eu/*",
    "https://aistudio.google.com/*",
    "https://ai.studio/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*", "https://ai.studio/*"],
      "js": ["capture-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://aistudio.google.com/*", "https://ai.studio/*"],
      "js": ["capture-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
